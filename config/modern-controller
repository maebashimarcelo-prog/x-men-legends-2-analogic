; XML2 Modern Controller configuration - v0.5.0-beta.1
; Keep the legacy filename true-analog.ini for compatibility.
[Controller]
TrueAnalogMovement=1
Deadzone=0.15
; This beta requires PreserveMagnitude=1; 0 safely disables the movement hook.
PreserveMagnitude=1
ControllerIndex=0
; Support sampling is off. Enable only briefly when requested.
DebugInput=0

[General]
HotPlug=1
DynamicPrompts=1
ControllerGlyphs=1
TutorialControllerText=1
AdvancedController=1
AdvancedTrace=0
PromptTrace=0
ControllerTrace=0

[Player1]
ControllerType=Auto
GlyphStyle=Auto
Preset=ConsoleDefault
RestoreConsoleDefaults=0
; Existing custom bindings are preserved; P2-P4 remain unassigned by default.
